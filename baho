local function makeButton(parent, text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -12, 0, 36)
    b.Position = UDim2.fromOffset(6, y)
    b.BackgroundColor3 = panel
    b.Text = text
    b.TextColor3 = white
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local body = Instance.new("Frame")
body.Position = UDim2.fromOffset(0, 42)
body.Size = UDim2.new(1, 0, 1, -42)
body.BackgroundTransparency = 1
body.Parent = content

local function clearBody()
    for _, child in ipairs(body:GetChildren()) do
        child:Destroy()
    end
end

local function addToggle(label, y, callback)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(0, y)
    row.Size = UDim2.new(1, 0, 0, 43)
    row.BackgroundColor3 = panel
    row.BorderSizePixel = 0
    row.Parent = body
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local text = Instance.new("TextLabel")
    text.Position = UDim2.fromOffset(12, 0)
    text.Size = UDim2.new(1, -75, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = label
    text.TextColor3 = white
    text.TextSize = 13
    text.Font = Enum.Font.Gotham
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = row

    local on = false
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(42, 23)
    button.Position = UDim2.new(1, -54, 0.5, -11)
    button.BackgroundColor3 = Color3.fromRGB(65, 65, 80)
    button.Text = "OFF"
    button.TextColor3 = white
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
    button.Parent = row
    Instance.new("UICorner", button).CornerRadius = UDim.new(1, 0)

    button.MouseButton1Click:Connect(function()
        on = not on
        button.Text = on and "ON" or "OFF"
        button.BackgroundColor3 = on and purple
            or Color3.fromRGB(65, 65, 80)
        if callback then callback(on) end
    end)
end

local function showMain()
    clearBody()
    addToggle("Enable Feature 1", 4)
    addToggle("Enable Feature 2", 54)
    addToggle("Enable Feature 3", 104)

    local info = Instance.new("TextLabel")
    info.Position = UDim2.fromOffset(4, 164)
    info.Size = UDim2.new(1, -8, 0, 50)
    info.BackgroundTransparency = 1
    info.Text = "Purple UI  •  Customize these controls\nConnect each toggle to your own game logic."
    info.TextColor3 = Color3.fromRGB(165, 160, 185)
    info.TextSize = 11
    info.Font = Enum.Font.Gotham
    info.TextWrapped = true
    info.Parent = body
end

local function showSettings()
    clearBody()
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 70)
    label.BackgroundTransparency = 1
    label.Text = "Settings\n\nCustomize your own game features here."
    label.TextColor3 = white
    label.TextSize = 15
    label.Font = Enum.Font.Gotham
    label.TextWrapped = true
    label.Parent = body
end

makeButton(sidebar, "◆  Main", 14).MouseButton1Click:Connect(showMain)
makeButton(sidebar, "⚙  Settings", 58).MouseButton1Click:Connect(showSettings)

local minimized = false
minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    sidebar.Visible = not minimized
    content.Visible = not minimized
    main.Size = minimized
        and UDim2.fromOffset(570, 48)
        or UDim2.fromOffset(570, 365)
    minimize.Text = minimized and "+" or "−"
end)

-- Drag window using the title bar
local dragging = false
local dragStart, startPos

top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

showMain()
