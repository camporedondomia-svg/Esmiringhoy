    R('rtx','rtx',COL('#f2d4e0'),TG(false))
  ])
 ]
];

P['Visuals/VoidShoot']=[
 [
  S('voidshoot',[
    R('en','enable voidshoot',TG(false))
  ])
 ],
 []
];

const PREVIEW=`<div class="pv" id="pv"><div class="pvname">Player</div><div class="pvwrap"><div class="pvhp"></div><div class="pvbox"><div class="pvfill"></div><svg class="pvfig" viewBox="0 0 60 120" width="60" height="120"><circle cx="30" cy="20" r="14" fill="#c98a4b"/><rect x="18" y="36" width="24" height="46" rx="10" fill="#c98a4b"/><rect x="20" y="80" width="8" height="34" rx="4" fill="#b87a3e"/><rect x="32" y="80" width="8" height="34" rx="4" fill="#b87a3e"/><rect x="8" y="40" width="9" height="36" rx="4" fill="#b87a3e"/><rect x="43" y="40" width="9" height="36" rx="4" fill="#b87a3e"/></svg></div></div><div class="pvdist">[15m]</div><div class="pvtool">[Revolver]</div></div>`;

function updatePreview(){
  const pv=$('#pv'); if(!pv) return;
  const g=k=>ST['Visuals/Players Esp|'+k];
  pv.style.display=g('prev.tg')?'':'none';
  $('.pvbox',pv).style.borderColor=g('box.tg')?g('box.col'):'transparent';
  const f=$('.pvfill',pv);
  f.style.background=g('fill.tg')?g('fill.cola'):'transparent';
  f.style.opacity=1-g('ftr.sl');
  const master=g('tem.tg');
  const nm=$('.pvname',pv); nm.style.display=master&&g('names.tg')?'':'none'; nm.style.color=g('names.col');
  const ds=$('.pvdist',pv); ds.style.display=master&&g('dist.tg')?'':'none'; ds.style.color=g('dist.col');
  const tl=$('.pvtool',pv); tl.style.display=master&&g('tools.tg')?'':'none'; tl.style.color=g('tools.col');
  const hp=$('.pvhp',pv); hp.style.visibility=g('hp.tg')?'visible':'hidden';
  hp.style.background=`linear-gradient(${g('hp.colhi')},${g('hp.colmid')},${g('hp.collo')})`;
  const opts=['triple t','dummy','silhouette'];
  $('.pvfig',pv).style.filter=`hue-rotate(${opts.indexOf(g('pimg.dd'))*70}deg)`;
}

const TABS=[
  {n:'Legit',k:'L'},
  {n:'RageBot',k:'R',sub:['Combat','Visuals & Audio']},
  {n:'KnifeBot',k:'K',dbl:true,sub:['Movement','Desync','Morphs & Anims']},
  {n:'Misc',k:'M',sub:['Movement','Desync','Morphs & Anims','Automation']},
  {n:'Visuals',k:'V',sub:['Players Esp','self visuals','World Visuals','VoidShoot']}
];
const SUBICON={
  'VoidShoot':'<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><path d="M8 5.500V4.500a1.500 1.500 0 1 0-1.500-1.500M8 5.500L14.500 11a1 1 0 0 1-.6 1.800H2.100A1 1 0 0 1 1.500 11L8 5.500z"/></svg>',
  'Players Esp':'<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 3C4.5 3 2 6 1 8c1 2 3.5 5 7 5s6-3 7-5c-1-2-3.5-5-7-5zm0 8.2A3.2 3.2 0 1 1 8 4.800a3.200 3.200 0 0 1 0 6.400z"/><circle cx="8" cy="8" r="1.500"/></svg>',
  'self visuals':'<svg viewBox="0 0 16 16"><text x="8" y="12.5" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor" font-family="sans-serif">H</text></svg>',
  'World Visuals':'<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="8" cy="8" r="2.6"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M12.6 3.4l-1.3 1.3M4.7 11.3l-1.3 1.3"/></svg>',
  'Movement':'<svg viewBox="0 0 16 16" fill="currentColor"><circle cx="9.5" cy="3" r="1.8"/><path d="M6 6l3-1 2 2.5 2.5.5-.4 1.3-3.1-.6-1-1.2-.8 2.3 2 2V15H8.6v-2.7L7 11l-1.3 3.3-1.4-.6L6 6z"/></svg>',
  'Desync':'<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l5.5 2v4.5c0 3.3-2.3 5.7-5.5 7.5C4.8 13.2 2.5 10.8 2.5 7.5V3L8 1z"/><path d="M5.5 8l1.8 1.8L10.8 6" fill="none" stroke="#15151c" stroke-width="1.4"/></svg>',
  'Morphs & Anims':'<svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="4.5" r="2.7"/><path d="M2.5 14c0-3 2.4-5 5.5-5s5.5 2 5.5 5z"/></svg>',
  'Automation':'<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.3"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2l-1.4 1.4"/></svg>',
  'Combat':'<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="5.5"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/><path d="M8 0.5v3M8 12.5v3M0.5 8h3M12.5 8h3"/></svg>',
  'Visuals & Audio':'<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="currentColor"/><circle cx="8" cy="8" r="2.6" fill="#15151c"/></svg>'
};

/* =========================================================
   STATE (values, configs)
   ========================================================= */
const id_=(page,row,part)=>page+'|'+row.id+'.'+part.k+(part.n||'');
const DEF={};
for(const pg in P) P[pg].forEach(c=>c.forEach(s=>s.rows.forEach(r=>r.parts.forEach(p=>{ if(p.k!=='btn'&&p.k!=='gear') DEF[id_(pg,r,p)]=p.v; }))));
let ST={...DEF};

const KEYSTORE='mogumogu_configs';
let store={};
try{ store=JSON.parse(localStorage.getItem(KEYSTORE)||'{}'); }catch(e){ store={}; }
const persist=()=>{ try{ localStorage.setItem(KEYSTORE,JSON.stringify(store)); }catch(e){} };
let curCfg='Default';

function toast(m){
  const t=$('#toast'); t.textContent=m; t.classList.add('show');
  clearTimeout(toast.t); toast.t=setTimeout(()=>t.classList.remove('show'),1500);
}

function fillCfgSelect(){
  const names=['Default',...Object.keys(store)];
  $('#cfgSel').innerHTML=names.map(n=>`<option ${n===curCfg?'selected':''}>${n}</option>`).join('');
}
$('#cfgSel').onchange=e=>{
  curCfg=e.target.value;
  ST=curCfg==='Default'?{...DEF}:{...DEF,...store[curCfg]};
  renderPage(); toast('Loaded '+curCfg);
};
$('#saveBtn').onclick=()=>{
  if(curCfg==='Default'){
    let n=1; while(store['Config '+n]) n++;
    curCfg='Config '+n;
  }
  store[curCfg]={...ST}; persist(); fillCfgSelect(); toast('Saved '+curCfg);
};

/* =========================================================
   RENDERING
   ========================================================= */
const decOf=s=>(String(s).split('.')[1]||'').length;
const fmt=(v,s)=>String(parseFloat(Number(v).toFixed(decOf(s))));

function partHTML(pg,r,p){
  const id=id_(pg,r,p), v=ST[id];
  switch(p.k){
    case 'gear': return `<span class="gear" data-msg="${r.l}"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8" cy="8" r="2.4"/><path d="M8 1.5v2.2M8 12.3v2.2M1.5 8h2.2M12.3 8h2.2M3.4 3.4l1.6 1.6M11 11l1.6 1.6M12.6 3.4L11 5M5 11l-1.6 1.6"/></svg></span>`;
    case 'key': return `<span class="key" data-id="${id}">${v}</span>`;
    case 'col': return `<input type="color" class="sw" data-id="${id}" value="${v}">`;
    case 'tg':  return `<div class="tg ${v?'on':''}" data-id="${id}"></div>`;
    case 'dd':  return `<select class="dd" data-id="${id}">${p.o.map(o=>`<option ${o===v?'selected':''}>${o}</option>`).join('')}</select>`;
    case 'sl':  return `<div class="sl" data-id="${id}" data-min="${p.min}" data-max="${p.max}" data-step="${p.s}"><div class="fill"></div><div class="knob"></div><span class="val">${fmt(v,p.s)}</span></div>`;
  }
  return '';
}
function rowHTML(pg,r){
  if(r.parts[0].k==='btn')
    return `<div class="row btn" data-msg="${r.l}"><span class="lb"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 1.5L3.5 6 8 10.5"/></svg>${r.l}</span></div>`;
  return `<div class="row"><span class="lb">${r.l}</span><div class="right">${r.parts.map(p=>partHTML(pg,r,p)).join('')}</div></div>`;
}

let cur={tab:'Legit',sub:null,open:false};
const pageKey=()=>cur.sub?(cur.tab==='KnifeBot'?'Misc':cur.tab)+'/'+cur.sub:cur.tab;

function renderTabs(){
  $('#tabs').innerHTML=TABS.map(t=>{
    const act=cur.tab===t.n;
    let h=`<div class="tab ${act?'active':''}" data-tab="${t.n}"><b>${t.k}</b>${t.n}</div>`;
    if(t.sub && act && (!t.dbl||cur.open)) h+=t.sub.map(s=>`<div class="tab sub ${cur.sub===s?'active':''}" data-tab="${t.n}" data-sub="${s}">${SUBICON[s]||''}${s}</div>`).join('');
    return h;
  }).join('');
}

function setSlider(el){
  const min=+el.dataset.min,max=+el.dataset.max,step=+el.dataset.step;
  const v=ST[el.dataset.id], p=(v-min)/(max-min);
  const left=`calc(${p} * (100% - 12px) + 6px)`;
  $('.fill',el).style.width=p<=0?'0':left;
  $('.knob',el).style.left=left;
  $('.val',el).textContent=fmt(v,step);
}

function renderPage(){
  const pg=pageKey(), data=P[pg], c=$('#content');
  if(!data){ c.innerHTML=`<div class="placeholder">${cur.sub||cur.tab} — empty page</div>`; return; }
  c.innerHTML=data.map(col=>`<div class="col">${col.map(s=>`<div class="sec">${s.t}</div><div class="box">${s.rows.map(r=>rowHTML(pg,r)).join('')}${s.pv?PREVIEW:''}</div>`).join('')}</div>`).join('');
  c.querySelectorAll('.sl').forEach(setSlider);
  c.scrollTop=0;
  applyFilter();
  updatePreview();
}

function render(){ renderTabs(); renderPage(); }

/* =========================================================
   INTERACTION
   ========================================================= */
// tabs
$('#tabs').addEventListener('click',e=>{
  const t=e.target.closest('.tab'); if(!t) return;
  const def=TABS.find(x=>x.n===t.dataset.tab);
  const switching=cur.tab!==def.n;
  if(switching) cur.open=false;
  if(t.dataset.sub) cur.sub=t.dataset.sub;
  else if(def.dbl){ if(!switching && cur.sub===null) return; cur.sub=null; }
  else if(switching) cur.sub=def.sub?def.sub[0]:null;
  cur.tab=def.n;
  $('#q').value='';
  render();
});

// double-click KnifeBot -> show / hide its sub pages
$('#tabs').addEventListener('dblclick',e=>{
  const t=e.target.closest('.tab:not(.sub)'); if(!t) return;
  const def=TABS.find(x=>x.n===t.dataset.tab); if(!def||!def.dbl) return;
  cur.tab=def.n; cur.open=!cur.open; if(!cur.open) cur.sub=null;
  render();
});

const content=$('#content');

// toggles / keybinds / buttons
let binding=null;
content.addEventListener('click',e=>{
  const tg=e.target.closest('.tg');
  if(tg){ tg.classList.toggle('on'); ST[tg.dataset.id]=tg.classList.contains('on'); return; }
  const k=e.target.closest('.key');
  if(k){
    if(binding) binding.classList.remove('binding');
    binding=k; k.classList.add('binding'); k.textContent='...'; return;
  }
  const gr=e.target.closest('.gear');
  if(gr){ toast(gr.dataset.msg+' settings'); return; }
  const b=e.target.closest('.row.btn');
  if(b) toast(b.dataset.msg+' clicked');
});
addEventListener('keydown',e=>{
  if(!binding) return;
  e.preventDefault();
  const id=binding.dataset.id;
  if(e.key!=='Escape') ST[id]=e.key.length===1?e.key.toUpperCase():e.key.slice(0,6);
  binding.textContent=ST[id]; binding.classList.remove('binding'); binding=null;
});
addEventListener('pointerdown',e=>{
  if(binding && !e.target.closest('.key')){ binding.textContent=ST[binding.dataset.id]; binding.classList.remove('binding'); binding=null; }
});

// dropdowns & colors
content.addEventListener('change',e=>{
  if(e.target.matches('select.dd')) ST[e.target.dataset.id]=e.target.value;
});
content.addEventListener('input',e=>{
  if(e.target.matches('input.sw')) ST[e.target.dataset.id]=e.target.value;
});

// sliders
content.addEventListener('pointerdown',e=>{
  const s=e.target.closest('.sl'); if(!s) return;
  const min=+s.dataset.min,max=+s.dataset.max,step=+s.dataset.step;
  const move=ev=>{
    const r=s.getBoundingClientRect();
    const p=Math.min(1,Math.max(0,(ev.clientX-r.left)/r.width));
    let v=Math.round((p*(max-min))/step)*step+min;
    v=parseFloat(v.toFixed(decOf(step)));
    ST[s.dataset.id]=Math.min(max,Math.max(min,v));
    setSlider(s);
  };
  const up=()=>{removeEventListener('pointermove',move);removeEventListener('pointerup',up)};
  move(e);
  addEventListener('pointermove',move); addEventListener('pointerup',up);
});

['click','change','input'].forEach(ev=>content.addEventListener(ev,()=>setTimeout(updatePreview,0)));

// search
function applyFilter(){
  const q=$('#q').value.trim().toLowerCase();
  content.querySelectorAll('.box').forEach(box=>{
    let any=false;
    box.querySelectorAll('.row').forEach(r=>{
      const m=!q||r.querySelector('.lb').textContent.toLowerCase().includes(q);
      r.style.display=m?'':'none'; if(m) any=true;
    });
    box.style.display=any?'':'none';
    if(box.previousElementSibling) box.previousElementSibling.style.display=any?'':'none';
  });
}
$('#sBtn').onclick=()=>{
  const q=$('#q'); q.classList.toggle('open');
  if(q.classList.contains('open')) q.focus(); else { q.value=''; applyFilter(); }
};
$('#q').oninput=applyFilter;

// drag window
const win=$('#win');
let ox,oy,dragging=false;
const startDrag=e=>{
  if(e.target.closest('.tab,.cfg,.rt')) return;
  dragging=true; const r=win.getBoundingClientRect(); ox=e.clientX-r.left; oy=e.clientY-r.top;
};
$('#drag').addEventListener('pointerdown',startDrag);
$('#topbar').addEventListener('pointerdown',startDrag);
addEventListener('pointermove',e=>{ if(dragging){ win.style.left=e.clientX-ox+'px'; win.style.top=e.clientY-oy+'px'; win.style.margin=0; } });
addEventListener('pointerup',()=>dragging=false);

fillCfgSelect();
render();
</script>
</body>
</html>
