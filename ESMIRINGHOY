        Size = UDim2.fromOffset(34, 22),
        BackgroundTransparency = 1,
        Text = tostring(item.default),
        TextColor3 = COLORS.dim,
        TextSize = 10,
        Font = Enum.Font.Gotham,
    }, holder)
    values[item.name] = item.default

    local function setFromX(x)
        local percent = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local value = math.floor((item.min + percent * (item.max-item.min)) + 0.5)
        values[item.name] = value
        fill.Size = UDim2.new(percent, 0, 1, 0)
        valueText.Text = tostring(value)
    end
    local active = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)
end

local function renderTab(tabName)
    pageTitle.Text = tabName
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    for _, sectionData in ipairs(tabs[tabName] or {}) do
        local _, card = makeSection(sectionData[1])
        for _, item in ipairs(sectionData[2]) do
            if item.type == "toggle" then
                addToggle(card, item)
            elseif item.type == "dropdown" then
                addDropdown(card, item)
            elseif item.type == "slider" then
                addSlider(card, item)
            elseif item.type == "label" then
                local row = makeRow(card, item.name)
                row.Size = UDim2.new(1, 0, 0, 48)
                local label = row:FindFirstChildOfClass("TextLabel")
                label.TextWrapped = true
                label.TextColor3 = COLORS.dim
            end
        end
    end
    content.CanvasPosition = Vector2.zero
end

