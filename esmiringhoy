    b.AutoButtonColor = false
    b.Parent = sidebar
    corner(b, 8)

    local icon = label(b, iconText, 13,
        UDim2.fromOffset(10, 3), C.Gray, Enum.Font.GothamBold)
    icon.Size = UDim2.fromOffset(15, 23)

    local text = label(b, name, 11,
        UDim2.fromOffset(29, 3), C.White)
    text.Size = UDim2.new(1, -35, 0, 23)

    tabButtons[name] = b

    b.Activated:Connect(function()
        currentTab = name

        for tabName, button in pairs(tabButtons) do
            button.BackgroundColor3 =
                tabName == name and C.Element or C.Sidebar
        end
    end)
end

