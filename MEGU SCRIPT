local function toggle(label, key)
    local b
    local function refresh()
        b.Text = label .. "     " ..
            (settings[key] and "[ ON ]" or "[ OFF ]")
        b.TextColor3 = settings[key] and PURPLE or MUTED
    end

    b = button("", function()
        settings[key] = not settings[key]
        refresh()
    end)
    refresh()
end

local function keybind(label, key)
    local waiting = false
    local b

    local function refresh()
        b.Text = label .. "   [ " .. settings[key].Name .. " ]"
    end

    b = button("", function()
        waiting = true
        b.Text = label .. "   [ Press a key ]"
    end)
    refresh()

    UIS.InputBegan:Connect(function(input, processed)
        if not waiting or processed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        settings[key] = input.KeyCode
        waiting = false
        refresh()
    end)
end

-- Find a training dummy named TrainingDummy in Workspace.
local function getDummy()
    local dummy = workspace:FindFirstChild("TrainingDummy")
    if not dummy then return nil end
    return dummy:FindFirstChild("HumanoidRootPart")
        or dummy:FindFirstChild("Head")
end

-- Runtime state
local camera = workspace.CurrentCamera
local flyAttachment
local flyVelocity
local flyOrientation
local originalSpeed
local lastSpam = 0
local lastCharacter

local function getCharacter()
    return player.Character
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function stopFly()
    if flyVelocity then flyVelocity:Destroy() flyVelocity = nil end
    if flyOrientation then
        flyOrientation:Destroy()
        flyOrientation = nil
    end
    if flyAttachment then
        flyAttachment:Destroy()
        flyAttachment = nil
    end
end

local function startFly(root)
    stopFly()

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "MTXFlyAttachment"
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "MTXFlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.MaxForce = 100000
    flyVelocity.Parent = root

    flyOrientation = Instance.new("AlignOrientation")
    flyOrientation.Attachment0 = flyAttachment
    flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyOrientation.MaxTorque = 100000
    flyOrientation.Responsiveness = 15
    flyOrientation.Parent = root
end

local function updateFly(root)
    if not flyVelocity or not camera then return end

    local direction = Vector3.zero
    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector

    if UIS:IsKeyDown(Enum.KeyCode.W) then direction += look end
    if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= look end
    if UIS:IsKeyDown(Enum.KeyCode.D) then direction += right end
    if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= right end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        direction += Vector3.yAxis
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        direction -= Vector3.yAxis
    end

    if direction.Magnitude > 0 then
        direction = direction.Unit
    end

    flyVelocity.VectorVelocity = direction * settings.FlySpeed
    flyOrientation.CFrame = camera.CFrame.Rotation
end

local function showTab(tab)
    clear()

    if tab == "Combat" then
        heading("Training Camera")
        toggle("Smooth Camlock (TrainingDummy)", "Camlock")
        heading("Visual Effects")
        toggle("Character Spin", "Spin")
        heading("Movement")
        toggle("Fly", "Fly")
        toggle("Speed", "Speed")
        heading("Testing")
        toggle("Auto Spam (local test log)", "AutoSpam")
        button("Print test action", function()
            print("MTX test action executed.")
        end)

    elseif tab == "Settings" then
        heading("Movement Settings")
        button("Walk Speed: " .. settings.WalkSpeed, function()
            settings.WalkSpeed =
                settings.WalkSpeed >= 60 and 16
                or settings.WalkSpeed + 4
            showTab("Settings")
        end)
        button("Fly Speed: " .. settings.FlySpeed, function()
            settings.FlySpeed =
                settings.FlySpeed >= 85 and 25
                or settings.FlySpeed + 10
            showTab("Settings")
        end)
        button("Spin Speed: " .. settings.SpinSpeed, function()
            settings.SpinSpeed =
                settings.SpinSpeed >= 30 and 5
                or settings.SpinSpeed + 5
            showTab("Settings")
        end)
        button("Cam Smoothness: " ..
            string.format("%.2f", settings.Smoothness), function()
            settings.Smoothness =
                settings.Smoothness >= 0.5 and 0.05
                or settings.Smoothness + 0.05
            showTab("Settings")
        end)

    elseif tab == "Keys" then
        heading("Toggle Keybinds")
        keybind("Camlock", "CamlockKey")
        keybind("Spin", "SpinKey")
        keybind("Fly", "FlyKey")
        keybind("Speed", "SpeedKey")
        keybind("Auto Spam", "SpamKey")
        heading("WASD + Space/Ctrl control flight")

    else
        heading("Welcome to MTX")
        local info = Instance.new("TextLabel")
        info.Size = UDim2.new(1, -4, 0, 65)
        info.BackgroundTransparency = 1
        info.Text = "Studio training UI\nTarget: Workspace.TrainingDummy\nAll test actions are local."
        info.TextColor3 = MUTED
        info.TextSize = 12
        info.Font = Enum.Font.Gotham
        info.TextWrapped = true
        info.TextXAlignment = Enum.TextXAlignment.Left
        info.Parent = content

        button("Reset UI Position", function()
            main.Position = UDim2.new(0.5, -255, 0.5, -205)
        end)
        button("Reset Settings", function()
            settings.Camlock = false
            settings.Spin = false
            settings.Fly = false
            settings.Speed = false
            settings.AutoSpam = false
            settings.WalkSpeed = 28
            settings.FlySpeed = 45
            settings.SpinSpeed = 12
            settings.Smoothness = 0.18
            settings.SpamInterval = 0.25
            showTab("Home")
        end)
    end
end

