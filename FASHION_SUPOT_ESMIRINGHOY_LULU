local purple = Color3.fromRGB(155, 90, 255)
local bg = Color3.fromRGB(19, 17, 29)
local panel = Color3.fromRGB(36, 31, 49)
local white = Color3.fromRGB(245, 240, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "PurpleCombatV3"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(350, 430)
main.Position = UDim2.new(0.5, -175, 0.5, -215)
main.BackgroundColor3 = bg
main.BorderSizePixel = 0
main.Parent = gui
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

local outline = Instance.new("UIStroke", main)
outline.Color = purple
outline.Thickness = 1.5

local title = Instance.new("TextLabel")
