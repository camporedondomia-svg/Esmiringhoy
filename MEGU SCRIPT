-- Keyboard toggles
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    local key = input.KeyCode
    if key == settings.CamlockKey then
        settings.Camlock = not settings.Camlock
    elseif key == settings.SpinKey then
        settings.Spin = not settings.Spin
    elseif key == settings.FlyKey then
        settings.Fly = not settings.Fly
    elseif key == settings.SpeedKey then
        settings.Speed = not settings.Speed
    elseif key == settings.SpamKey then
        settings.AutoSpam = not settings.AutoSpam
    end
end)

-- Main update loop
RunService.RenderStepped:Connect(function(dt)
    local char = getCharacter()
    local humanoid = getHumanoid()
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    if char ~= lastCharacter then
        stopFly()
        lastCharacter = char
        originalSpeed = humanoid.WalkSpeed
    end

    if settings.Speed then
        humanoid.WalkSpeed = settings.WalkSpeed
    elseif originalSpeed then
        humanoid.WalkSpeed = originalSpeed
    end

    if settings.Fly then
        humanoid.PlatformStand = true
        if not flyVelocity then startFly(root) end
        updateFly(root)
    else
        if flyVelocity then stopFly() end
        humanoid.PlatformStand = false
    end

    if settings.Spin then
        root.AssemblyAngularVelocity = Vector3.new(
            0, settings.SpinSpeed, 0
        )
    end

    if settings.Camlock and camera then
        local target = getDummy()
        if target then
            local desired = CFrame.lookAt(
                camera.CFrame.Position, target.Position
            )
            camera.CFrame = camera.CFrame:Lerp(
                desired, math.clamp(settings.Smoothness, 0, 1)
            )
        end
    end

    if settings.AutoSpam and os.clock() - lastSpam >= settings.SpamInterval then
        lastSpam = os.clock()
        print("MTX local test spam:", os.clock())
    end
end)

-- Restore camera and movement on script removal.
gui.Destroying:Connect(function()
    stopFly()
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
        if originalSpeed then humanoid.WalkSpeed = originalSpeed end
    end
end)
