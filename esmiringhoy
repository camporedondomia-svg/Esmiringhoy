-- TOGGLE CONTROL

local function makeToggle(parent, text, y, default)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(8, y)
    row.Size = UDim2.new(1, -16, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = parent

    label(row, text, 11, UDim2.fromOffset(3, 3), C.White)

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(31, 17)
    toggle.Position = UDim2.new(1, -33, 0, 6)
    toggle.Text = ""
    toggle.BackgroundColor3 = default and C.Blue or C.Element
    toggle.Parent = row
    corner(toggle, 12)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(13, 13)
    dot.Position = default and UDim2.fromOffset(16, 2)
        or UDim2.fromOffset(2, 2)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    dot.Parent = toggle
    corner(dot, 10)

    local state = default or false

    toggle.Activated:Connect(function()
        state = not state
        toggle.BackgroundColor3 = state and C.Blue or C.Element
        dot.Position = state and UDim2.fromOffset(16, 2)
            or UDim2.fromOffset(2, 2)
    end)

    return toggle
end

-- DROPDOWN

local function makeDropdown(parent, text, y, value, options)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(8, y)
    row.Size = UDim2.new(1, -16, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = parent

    label(row, text, 11, UDim2.fromOffset(3, 3), C.White)

    local drop = Instance.new("TextButton")
    drop.Size = UDim2.fromOffset(100, 22)
    drop.Position = UDim2.new(1, -103, 0, 3)
    drop.BackgroundColor3 = C.Element
    drop.Text = value .. "   ⌄"
    drop.TextColor3 = C.Gray
    drop.TextSize = 10
    drop.Font = Enum.Font.Gotham
    drop.Parent = row
    corner(drop, 6)

    local index = table.find(options, value) or 1

    drop.Activated:Connect(function()
        index = index % #options + 1
        drop.Text = options[index] .. "   ⌄"
    end)

    return drop
end

-- SLIDER

local function makeSlider(parent, text, y, value, maxValue)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(8, y)
    row.Size = UDim2.new(1, -16, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = parent

    label(row, text, 11, UDim2.fromOffset(3, 3), C.White)

    local track = Instance.new("TextButton")
    track.Size = UDim2.fromOffset(110, 5)
    track.Position = UDim2.new(1, -120, 0, 13)
    track.BackgroundColor3 = C.Element
    track.Text = ""
    track.Parent = row
    corner(track, 5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(value/maxValue, 0, 1, 0)
    fill.BackgroundColor3 = C.Blue
    fill.Parent = track
    corner(fill, 5)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(10, 10)
    dot.Position = UDim2.new(value/maxValue, -5, 0.5, -5)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    dot.Parent = track
    corner(dot, 10)

    local number = Instance.new("TextLabel")
    number.Size = UDim2.fromOffset(35, 20)
    number.Position = UDim2.new(1, -39, 0, 0)
    number.BackgroundColor3 = C.Element
    number.Text = tostring(value)
    number.TextColor3 = C.Gray
    number.TextSize = 9
    number.Font = Enum.Font.Gotham
    number.Parent = row
    corner(number, 5)

    local dragging = false

    local function update(x)
        local ratio = math.clamp(
            (x - track.AbsolutePosition.X) /
            track.AbsoluteSize.X, 0, 1
        )

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        dot.Position = UDim2.new(ratio, -5, 0.5, -5)

        local newValue = math.floor(ratio * maxValue * 100) / 100
        number.Text = tostring(newValue)
    end

    track.Activated:Connect(function()
        update(UIS:GetMouseLocation().X)
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType ==
            Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

