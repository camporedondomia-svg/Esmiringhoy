local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(30, 30)
close.Position = UDim2.new(1, -40, 0, 8)
close.Text = "X"
close.TextColor3 = white
close.BackgroundColor3 = panel
close.Parent = main
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 7)

local targetLabel = Instance.new("TextLabel")
targetLabel.Position = UDim2.fromOffset(12, 46)
targetLabel.Size = UDim2.new(1, -24, 0, 30)
targetLabel.BackgroundColor3 = panel
targetLabel.Text = "Target: None"
targetLabel.TextColor3 = white
targetLabel.Font = Enum.Font.Gotham
targetLabel.TextSize = 12
targetLabel.Parent = main
Instance.new("UICorner", targetLabel).CornerRadius =
    UDim.new(0, 6)

local list = Instance.new("ScrollingFrame")
list.Position = UDim2.fromOffset(12, 84)
list.Size = UDim2.new(1, -24, 0, 115)
list.BackgroundColor3 = Color3.fromRGB(25, 22, 37)
list.BorderSizePixel = 0
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = purple
list.Parent = main
Instance.new("UICorner", list).CornerRadius = UDim.new(0, 7)

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 4)
layout.Parent = list

local selectedTarget
local distance = 5
local following = false
local spinning = false
local angle = 0
local heartbeat

local function button(text, y)
    local b = Instance.new("TextButton")
    b.Position = UDim2.fromOffset(12, y)
    b.Size = UDim2.new(1, -24, 0, 36)
    b.BackgroundColor3 = panel
    b.TextColor3 = white
    b.Text = text .. " [OFF]"
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.Parent = main
    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 7)
    return b
end

local function refresh()
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    local others = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(others, p)
        end
    end

    table.sort(others, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for i, p in ipairs(others) do
        local b = Instance.new("TextButton")
        b.LayoutOrder = i
        b.Size = UDim2.new(1, -8, 0, 30)
        b.BackgroundColor3 = panel
        b.TextColor3 = white
        b.Font = Enum.Font.Gotham
        b.TextSize = 12
        b.Text = p.DisplayName .. "  (@" .. p.Name .. ")"
        b.Parent = list
        Instance.new("UICorner", b).CornerRadius =
            UDim.new(0, 5)

        b.Activated:Connect(function()
            if p.Parent ~= Players then return end
            selectedTarget = p
            targetLabel.Text = "Target: @" .. p.Name
            for _, item in ipairs(list:GetChildren()) do
                if item:IsA("TextButton") then
                    item.BackgroundColor3 = panel
                end
            end
            b.BackgroundColor3 = purple
        end)
    end

    list.CanvasSize = UDim2.fromOffset(0, #others * 34)
end

Players.PlayerAdded:Connect(refresh)
Players.PlayerRemoving:Connect(function(p)
    if selectedTarget == p then
        selectedTarget = nil
        targetLabel.Text = "Target: None"
        following = false
    end
    refresh()
end)

local followButton = button("Follow Target (5 studs)", 210)
followButton.Activated:Connect(function()
    following = not following
    followButton.Text = "Follow Target (5 studs) " ..
        (following and "[ON]" or "[OFF]")
    followButton.BackgroundColor3 = following and purple or panel
end)

local spinButton = button("Spin Character", 252)
spinButton.Activated:Connect(function()
    spinning = not spinning
    spinButton.Text = "Spin Character " ..
        (spinning and "[ON]" or "[OFF]")
    spinButton.BackgroundColor3 = spinning and purple or panel
end)

local reloadButton = button("Reload (Demo)", 294)
reloadButton.Activated:Connect(function()
    targetLabel.Text = "Connect your own weapon reload system"
end)

local info = Instance.new("TextLabel")
info.Position = UDim2.fromOffset(15, 340)
info.Size = UDim2.new(1, -30, 0, 65)
info.BackgroundTransparency = 1
info.Text = "Target follow and spin demo\nCombat requires your own game systems."
info.TextColor3 = Color3.fromRGB(175, 165, 195)
info.Font = Enum.Font.Gotham
info.TextSize = 11
info.TextWrapped = true
info.Parent = main

heartbeat = RunService.Heartbeat:Connect(function(dt)
    if not following and not spinning then return end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if following then
        local targetCharacter = selectedTarget
            and selectedTarget.Character
        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")

        if targetRoot then
            local offset = targetRoot.Position - root.Position
            local direction = Vector3.new(offset.X, 0, offset.Z)

            if direction.Magnitude > 0.01 then
                local position = targetRoot.Position
                    - direction.Unit * distance

                root.CFrame = CFrame.lookAt(
                    Vector3.new(position.X, root.Position.Y, position.Z),
                    Vector3.new(
                        targetRoot.Position.X,
                        root.Position.Y,
                        targetRoot.Position.Z
                    )
                )
            end
        end
    end

    if spinning then
        angle = (angle + dt * 4) % (math.pi * 2)
        root.CFrame = root.CFrame * CFrame.Angles(0, dt * 4, 0)
    end
end)

close.Activated:Connect(function()
    if heartbeat then heartbeat:Disconnect() end
    gui:Destroy()
end)

refresh()
print("Purple Combat V3 loaded")
